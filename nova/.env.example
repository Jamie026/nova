# Copia este archivo como .env y rellena los valores. .env está en .gitignore.

# --- Obligatorio --------------------------------------------------------------
# Clave del modelo de lenguaje. https://platform.deepseek.com
DEEPSEEK_API_KEY=

# --- Wake word (opcional, muy recomendado) ------------------------------------
# Clave gratuita de Picovoice: https://console.picovoice.ai (cuenta personal;
# la AccessKey aparece en el panel al instante, sin esperar respuesta de nadie).
# Sin ella, Nova cae a openWakeWord, que no pide clave ni registro pero sólo
# reconoce unas pocas palabras fijas: despierta con "hey Jarvis" en vez de "Nova".
PICOVOICE_ACCESS_KEY=
# Ruta al .ppn de "Nova" generado en la consola de Picovoice.
# Sin él se usa un keyword integrado ("jarvis").
NOVA_WAKE_KEYWORD_PATH=

# --- Overrides opcionales -----------------------------------------------------
# NOVA_WAKE_ENGINE=porcupine     # porcupine | openwakeword | whisper | off
# NOVA_STT_MODEL=small           # tiny | base | small | medium | large-v3
# NOVA_STT_DEVICE=auto           # auto | cpu | cuda
# NOVA_LLM_MODEL=deepseek-chat
# NOVA_LLM_BASE_URL=https://api.deepseek.com
# --- Voz (ver sección 7 de INSTRUCCIONES.txt) ---
# Por defecto ("auto") Nova usa la voz clonada si está instalada (la instala
# setup.ps1 cuando hay GPU NVIDIA) con la referencia incluida en el repo, y
# si no, edge-tts. La voz clonada es inglesa: habla en inglés y subtitula en
# español, sin que tengas que poner nada. Sólo para forzarlo:
# NOVA_TTS_PROVIDER=edge        # auto | edge | chatterbox | mock
# NOVA_TTS_SPEAK_LANG=en        # idioma de la VOZ; los subtítulos siguen en `language`
# NOVA_TTS_REFERENCE=C:\ruta\a\mi-voz.wav   # clonar otra voz que la incluida
#
# NOVA_TTS_VOICE=es-PE-CamilaNeural
# NOVA_IPC_PORT=8765
# NOVA_LOG_LEVEL=DEBUG
# NOVA_MOCK=1                    # arranca sin APIs ni modelos pesados
